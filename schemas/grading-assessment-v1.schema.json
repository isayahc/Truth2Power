{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://truth2power.local/schemas/grading-assessment-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "grading-input-v1"
    },
    "synthetic": {
      "type": "boolean"
    },
    "hospital_key": {
      "$ref": "live-audit-v1.schema.json#/properties/hospital_key"
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "rubric_version": {
      "const": "css-17-v1"
    },
    "reference_version": {
      "const": "hhs-contiguous-2025-2026-v1"
    },
    "guideline_year": {
      "$ref": "live-audit-v1.schema.json#/properties/guideline_year"
    },
    "review_date": {
      "type": "string",
      "format": "date"
    },
    "attempt": {
      "$ref": "live-audit-v1.schema.json#/$defs/attempt"
    },
    "last_successful_assessment_at": {
      "type": "string",
      "format": "date-time"
    },
    "refresh_status": {
      "enum": [
        "current",
        "overdue",
        "unknown"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inventory_status": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "online_application": {
          "enum": [
            "present",
            "absent_after_search",
            "unknown"
          ]
        },
        "required_sources": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://",
            "maxLength": 4096
          },
          "uniqueItems": true
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "inventory_status",
        "online_application",
        "required_sources",
        "gaps"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://",
            "maxLength": 4096
          },
          "hospital_key": {
            "$ref": "live-audit-v1.schema.json#/properties/hospital_key"
          },
          "role": {
            "enum": [
              "application",
              "landing_page",
              "online_application",
              "policy_statement",
              "policy_summary",
              "psa_reference",
              "supplement",
              "uniform_reference"
            ]
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "reviewed",
              "available",
              "not_reviewed",
              "unavailable",
              "translation_needed",
              "unreadable",
              "unrelated"
            ]
          },
          "snapshot": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "snapshot_id": {
                    "$ref": "live-audit-v1.schema.json#/$defs/snapshot/properties/snapshot_id"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "artifact_path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "retrieved_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "publisher_updated_at": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https?://",
                    "maxLength": 4096
                  },
                  "final_url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://",
                    "maxLength": 4096
                  }
                },
                "required": [
                  "snapshot_id",
                  "sha256",
                  "artifact_path",
                  "retrieved_at",
                  "publisher_updated_at",
                  "url"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "source_id",
          "hospital_key",
          "role",
          "language",
          "status",
          "snapshot"
        ]
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "grading-finding-v1.schema.json"
      },
      "minItems": 17,
      "maxItems": 17
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "artifact_sha256",
        "original_id",
        "rubric_version",
        "reference_version",
        "finding_review",
        "decisions"
      ],
      "properties": {
        "format": {
          "enum": [
            "worker",
            "application-reviews",
            "full-reviews",
            "posting"
          ]
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "original_id": {
          "type": "string"
        },
        "rubric_version": {
          "type": "string"
        },
        "reference_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "finding_review": {
          "type": "object"
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "synthetic",
    "hospital_key",
    "assessment_id",
    "scope_id",
    "rubric_version",
    "reference_version",
    "guideline_year",
    "review_date",
    "attempt",
    "last_successful_assessment_at",
    "refresh_status",
    "scope",
    "sources",
    "findings"
  ]
}
