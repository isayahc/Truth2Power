{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hospital draft document identity declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "scope", "documents"],
  "properties": {
    "version": { "const": 1 },
    "scope": { "enum": ["selected_application", "posted_materials"] },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "role", "language", "snapshot_sha256"],
        "properties": {
          "url": { "type": "string", "format": "uri", "pattern": "^https?://" },
          "role": { "enum": ["application", "online_application", "landing_page", "policy_statement", "policy_summary", "supplement"] },
          "language": { "type": "string", "minLength": 1, "maxLength": 100 },
          "snapshot_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  },
  "allOf": [{
    "if": { "properties": { "scope": { "const": "selected_application" } } },
    "then": { "properties": { "documents": { "maxItems": 1, "items": { "properties": { "role": { "const": "application" } } } } } }
  }]
}
